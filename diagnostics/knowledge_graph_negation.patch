+# --- Negation handling (opt-in via KnowledgeGraphBuilder(negation_aware=True)) --
+# Phase 0.1 diagnostic found ~71% of abnormal-node positive labels are negation
+# artifacts ("no pleural effusion" -> effusion=1). When negation_aware is enabled,
+# an abnormal entity that appears ONLY in a negated sentence context is dropped.
+# Anatomy / normal nodes are unaffected. Default is OFF to preserve behaviour.
+NEG_CUES = {'no', 'not', 'without', 'negative', 'free', 'resolved', 'absent',
+            'cleared'}
+SCOPE_TERMINATORS = {'but', 'however', 'although', 'though', 'otherwise',
+                     'except', 'with', 'shows', 'showing', 'demonstrates',
+                     'demonstrating', 'reveals', 'revealing', 'redemonstrated'}
+ABNORMAL_CANON = frozenset(SYNONYM_MAP.get(w, w) for w in FINDING_ENTITIES['abnormal'])
+
 
